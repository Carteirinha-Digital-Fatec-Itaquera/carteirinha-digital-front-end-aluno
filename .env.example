# API real por padrão. Copie para .env.local e reinicie o Vite após alterar.
VITE_USE_MOCK=false
# Ajuste para o backend local ou publicado; sem esta variável, usa a URL do projeto.
VITE_API_URL=http://localhost:3000
# Ative VITE_USE_MOCK=true somente para desenvolvimento/testes explícitos.

# Opcional: origem pública do frontend usada no QR dos certificados.
# Sem valor, utiliza a origem atual do aplicativo.
VITE_PUBLIC_APP_URL=
